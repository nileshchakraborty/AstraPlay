<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <WebView
        android:id="@+id/xboxWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <!-- Loading progress line -->
    <ProgressBar
        android:id="@+id/loadingProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="top"
        android:indeterminate="false"
        android:progressTint="#107C10"
        android:elevation="25dp"
        android:translationZ="25dp" />

    <!-- Top Left: Subtle Game Title Pill (auto-fades) -->
    <LinearLayout
        android:id="@+id/streamStatusPill"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="12dp"
        android:layout_marginStart="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/icon_island_background"
        android:paddingHorizontal="12dp"
        android:elevation="20dp"
        android:translationZ="20dp"
        android:alpha="0.85">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_xbox"
            app:tint="#4CAF50" />

        <TextView
            android:id="@+id/overlayGameTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Xbox Cloud Gaming"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Top Right: Persistent, Highly Visible Exit Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/stopStreamButton"
        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:text="✕ Exit Stream"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:alpha="0.85"
        app:backgroundTint="#D914161F"
        app:strokeColor="#80FFFFFF"
        app:strokeWidth="1dp"
        app:cornerRadius="19dp"
        android:elevation="25dp"
        android:translationZ="25dp"
        android:focusable="true"
        android:clickable="true" />

</FrameLayout>
