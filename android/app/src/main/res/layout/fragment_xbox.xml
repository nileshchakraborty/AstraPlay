<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Header Bar -->
        <LinearLayout
            android:id="@+id/xboxHeaderBar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/toolbar_bg"
            android:paddingHorizontal="16dp">

            <!-- Gamertag / Status Pill -->
            <LinearLayout
                android:id="@+id/gamertagPill"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/icon_island_background"
                android:paddingHorizontal="12dp">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/ic_circle"
                    app:tint="#4CAF50" />

                <TextView
                    android:id="@+id/gamertagText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Not Logged In"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/refreshButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:text="Refresh"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                app:strokeColor="#40FFFFFF"
                app:cornerRadius="18dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/authActionButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Sign In"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                app:strokeColor="#107C10"
                app:cornerRadius="18dp" />
        </LinearLayout>

        <!-- Main Body Area -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- 1. Device Code Login Overlay/Card -->
            <ScrollView
                android:id="@+id/loginContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="16dp"
                        app:cardBackgroundColor="#1A162B"
                        app:strokeColor="#107C10"
                        app:strokeWidth="1dp"
                        app:cardElevation="6dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="24dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Device Code Login"
                                android:textColor="#FFFFFF"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Scan the QR code or go to https://www.microsoft.com/link and enter the code:"
                                android:textColor="#CCCCCC"
                                android:textSize="13sp"
                                android:gravity="center" />

                            <!-- User Code Box -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:orientation="horizontal"
                                android:gravity="center"
                                android:background="@drawable/icon_island_background"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="8dp">

                                <TextView
                                    android:id="@+id/userCodeText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="--------"
                                    android:textColor="#FFFFFF"
                                    android:textSize="22sp"
                                    android:textStyle="bold"
                                    android:letterSpacing="0.1" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/copyCodeButton"
                                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="32dp"
                                    android:layout_marginStart="12dp"
                                    android:text="Copy"
                                    android:textColor="#FFB74D"
                                    android:textSize="11sp"
                                    app:strokeColor="#FFB74D"
                                    app:cornerRadius="16dp" />
                            </LinearLayout>

                            <!-- QR Code -->
                            <ImageView
                                android:id="@+id/qrCodeImageView"
                                android:layout_width="180dp"
                                android:layout_height="180dp"
                                android:layout_marginTop="16dp"
                                android:background="#FFFFFF"
                                android:padding="8dp"
                                android:scaleType="fitCenter" />

                            <TextView
                                android:id="@+id/pollStatusText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:text="Waiting for authentication approval..."
                                android:textColor="#4CAF50"
                                android:textSize="13sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/cancelLoginButton"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="Cancel"
                                android:textColor="#FFB74D" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </ScrollView>

            <!-- 2. Games Catalog & Consoles Content (when signed in or browsing) -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/contentContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Section: My Xbox Consoles -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="My Xbox Consoles"
                        android:textColor="#4CAF50"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:cardCornerRadius="12dp"
                        app:cardBackgroundColor="#1A162B"
                        app:strokeColor="#30FFFFFF"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="20dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="No Xbox consoles discovered"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Ensure 'Remote features' are enabled on your Xbox (Settings > Devices &amp; connections > Remote features)."
                                android:textColor="#999999"
                                android:textSize="12sp"
                                android:gravity="center" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Section: Xbox Cloud Gaming -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/cloudSectionTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Xbox Cloud Gaming (xCloud)"
                            android:textColor="#4CAF50"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/gameCountText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="(573)"
                            android:textColor="#888888"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Direct Launch Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:cardCornerRadius="12dp"
                        app:cardBackgroundColor="#1A162B"
                        app:strokeColor="#30FFFFFF"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Direct Cloud Game Launch"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <EditText
                                    android:id="@+id/titleIdInput"
                                    android:layout_width="0dp"
                                    android:layout_height="40dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/icon_island_background"
                                    android:paddingHorizontal="12dp"
                                    android:hint="Enter Xbox Title ID (e.g. 1000XRESIST)..."
                                    android:textColor="#FFFFFF"
                                    android:textColorHint="#666666"
                                    android:textSize="13sp"
                                    android:singleLine="true" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/directStreamButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="40dp"
                                    android:layout_marginStart="8dp"
                                    android:text="Stream Game"
                                    android:textColor="#FFFFFF"
                                    android:textSize="12sp"
                                    app:backgroundTint="#107C10"
                                    app:cornerRadius="8dp" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Search Filter Box -->
                    <EditText
                        android:id="@+id/searchGamesInput"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/icon_island_background"
                        android:paddingHorizontal="14dp"
                        android:hint="Search Xbox Cloud Gaming titles..."
                        android:textColor="#FFFFFF"
                        android:textColorHint="#666666"
                        android:textSize="13sp"
                        android:singleLine="true" />

                    <!-- Games Grid -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/xboxGamesRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:nestedScrollingEnabled="false" />

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

        </FrameLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
