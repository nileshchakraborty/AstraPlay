<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_margin="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="16dp"
        app:cardBackgroundColor="#1A1C23"
        app:strokeWidth="1dp"
        app:strokeColor="#33FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="#242834"
                android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
                app:title="@string/psn_login_direct_title"
                app:navigationIcon="?attr/homeAsUpIndicator" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <!-- 1. Direct In-App WebView Layout (Default for Phone / Tablet) -->
                <LinearLayout
                    android:id="@+id/layoutWebView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <ProgressBar
                        android:id="@+id/webViewProgressBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="0"
                        android:progressTint="@color/accent"
                        android:visibility="gone" />

                    <!-- Passkey Info Banner -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="#1E2333"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_phone_android"
                            app:tint="#64B5F6"
                            android:layout_marginEnd="6dp"
                            android:contentDescription="Info" />

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/psn_login_passkey_notice"
                            android:textSize="11sp"
                            android:textColor="#90CAF9" />

                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="#121318">

                        <WebView
                            android:id="@+id/loginWebView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <!-- Loading / Authenticating Overlay -->
                        <LinearLayout
                            android:id="@+id/webViewLoadingOverlay"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="#E61A1C23"
                            android:visibility="gone">

                            <ProgressBar
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_marginBottom="16dp" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/webViewStatusText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/psn_login_authenticating"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF" />

                        </LinearLayout>

                    </FrameLayout>

                    <!-- Bottom Bar for WebView -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp"
                        android:background="#202430">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSwitchToPhoneRelay"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="@string/psn_login_switch_to_phone"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            app:cornerRadius="8dp"
                            app:icon="@drawable/ic_qr_code"
                            app:iconGravity="textStart"
                            app:strokeColor="@color/accent"
                            android:textColor="@color/accent"
                            app:iconTint="@color/accent" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOpenBrowserFromWebView"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="@string/psn_login_open_in_browser"
                            android:textSize="11sp"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_marginStart="6dp"
                            app:cornerRadius="8dp"
                            android:textColor="#90CAF9" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnManualTokenFromWebView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/psn_login_manual_option"
                            android:textSize="11sp"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:textColor="?android:textColorSecondary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCancelWebView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/action_cancel"
                            android:textSize="11sp"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:textColor="?android:textColorSecondary" />

                    </LinearLayout>

                </LinearLayout>

                <!-- 2. Phone Relay / QR Code Layout -->
                <ScrollView
                    android:id="@+id/layoutPhoneRelay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:paddingHorizontal="24dp"
                        android:paddingVertical="16dp">

                        <!-- QR Code card -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="216dp"
                            android:layout_height="216dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="2dp"
                            app:cardBackgroundColor="#FFFFFF"
                            app:strokeWidth="2dp"
                            app:strokeColor="@color/accent"
                            android:layout_marginBottom="10dp">

                            <ImageView
                                android:id="@+id/qrCodeImage"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="8dp"
                                android:scaleType="fitCenter"
                                android:contentDescription="QR code for login" />

                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/psn_login_scan_phone"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:textAlignment="center"
                            android:layout_marginBottom="4dp" />

                        <!-- Same Wi-Fi Network Notice -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:background="#242938"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="5dp"
                            android:layout_marginBottom="8dp">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_wifi"
                                app:tint="#64B5F6"
                                android:layout_marginEnd="6dp"
                                android:contentDescription="Wi-Fi" />

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/psn_login_same_wifi_hint"
                                android:textSize="11sp"
                                android:textColor="#90CAF9" />

                        </LinearLayout>

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/psn_login_code_label"
                            android:textSize="12sp"
                            android:textColor="?android:textColorSecondary"
                            android:layout_marginBottom="2dp" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/loginCodeText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="------"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:fontFamily="monospace"
                            android:letterSpacing="0.25"
                            android:layout_marginBottom="16dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/checkStatusButton"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:text="@string/psn_login_check_status"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:enabled="true"
                            android:layout_marginBottom="8dp"
                            app:cornerRadius="10dp"
                            app:backgroundTint="@color/psn_blue"
                            android:textColor="#FFFFFF" />

                        <!-- Sign in Directly (switches to WebView) -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/openBrowserButton"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="@string/psn_login_switch_to_direct"
                            android:textSize="14sp"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_marginBottom="8dp"
                            app:cornerRadius="10dp"
                            app:strokeColor="@color/accent"
                            android:textColor="#FFFFFF"
                            app:iconGravity="textStart"
                            app:iconTint="@color/accent"
                            app:icon="@android:drawable/ic_menu_view" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/manualTokenButton"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:text="@string/psn_login_paste_npsso"
                            android:textSize="13sp"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:textColor="#90CAF9"
                            android:layout_marginBottom="8dp"
                            app:cornerRadius="10dp" />

                        <!-- Status line -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <ProgressBar
                                android:id="@+id/progressBar"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_marginEnd="8dp"
                                android:visibility="visible" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/statusText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/psn_login_connecting"
                                android:textSize="13sp"
                                android:textColor="?android:textColorSecondary" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="end">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/configureRelayButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/psn_login_configure_relay"
                                android:textSize="11sp"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:textColor="?android:textColorTertiary" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/cancelButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/action_cancel"
                                android:textSize="12sp"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:textColor="?android:textColorTertiary" />
                        </LinearLayout>

                    </LinearLayout>

                </ScrollView>

            </FrameLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
