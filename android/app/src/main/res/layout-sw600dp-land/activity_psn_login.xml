<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="920dp"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_marginHorizontal="28dp"
        android:layout_marginVertical="20dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="16dp"
        app:cardBackgroundColor="#1A1C23"
        app:strokeWidth="1dp"
        app:strokeColor="#33FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="#242834"
                android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
                app:title="@string/psn_login_direct_title"
                app:navigationIcon="?attr/homeAsUpIndicator" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <!-- 1. Direct In-App WebView Layout (Default for Phone / Tablet) -->
                <LinearLayout
                    android:id="@+id/layoutWebView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <ProgressBar
                        android:id="@+id/webViewProgressBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="0"
                        android:progressTint="@color/accent"
                        android:visibility="gone" />

                    <!-- Passkey Info Banner -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="#1E2333"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="7dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_phone_android"
                            app:tint="#64B5F6"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="Info" />

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/psn_login_passkey_notice"
                            android:textSize="12sp"
                            android:textColor="#90CAF9" />

                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="#121318">

                        <WebView
                            android:id="@+id/loginWebView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <!-- Loading / Authenticating Overlay -->
                        <LinearLayout
                            android:id="@+id/webViewLoadingOverlay"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="#E61A1C23"
                            android:visibility="gone">

                            <ProgressBar
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:layout_marginBottom="16dp" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/webViewStatusText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/psn_login_authenticating"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF" />

                        </LinearLayout>

                    </FrameLayout>

                    <!-- Bottom Bar for WebView -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="10dp"
                        android:background="#202430">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSwitchToPhoneRelay"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:text="@string/psn_login_switch_to_phone"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            app:cornerRadius="10dp"
                            app:icon="@drawable/ic_qr_code"
                            app:iconGravity="textStart"
                            app:strokeColor="@color/accent"
                            android:textColor="@color/accent"
                            app:iconTint="@color/accent" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOpenBrowserFromWebView"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:text="@string/psn_login_open_in_browser"
                            android:textSize="12sp"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_marginStart="8dp"
                            app:cornerRadius="10dp"
                            android:textColor="#90CAF9" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnManualTokenFromWebView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/psn_login_manual_option"
                            android:textSize="12sp"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:textColor="?android:textColorSecondary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCancelWebView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/action_cancel"
                            android:textSize="12sp"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:textColor="?android:textColorSecondary" />

                    </LinearLayout>

                </LinearLayout>

                <!-- 2. Phone Relay / QR Code Layout (Default for Android TV, or fallback via button) -->
                <ScrollView
                    android:id="@+id/layoutPhoneRelay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="28dp"
                        android:baselineAligned="false">

                        <!-- Left Column: QR code -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="240dp"
                                android:layout_height="240dp"
                                app:cardCornerRadius="14dp"
                                app:cardElevation="4dp"
                                app:cardBackgroundColor="#FFFFFF"
                                app:strokeWidth="2dp"
                                app:strokeColor="@color/accent"
                                android:layout_marginBottom="14dp">

                                <ImageView
                                    android:id="@+id/qrCodeImage"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:padding="10dp"
                                    android:scaleType="fitCenter"
                                    android:contentDescription="QR code for login" />

                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/psn_login_scan_phone"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"
                                android:textAlignment="center"
                                android:layout_marginBottom="4dp" />

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/psn_login_scan_phone_subtitle"
                                android:textSize="12sp"
                                android:textColor="?android:textColorSecondary"
                                android:textAlignment="center" />

                            <!-- Same Wi-Fi Network Notice -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center"
                                android:background="#242938"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="8dp"
                                android:layout_marginTop="12dp"
                                android:layout_marginHorizontal="4dp">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_wifi"
                                    app:tint="#64B5F6"
                                    android:layout_marginEnd="8dp"
                                    android:contentDescription="Wi-Fi" />

                                <com.google.android.material.textview.MaterialTextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/psn_login_same_wifi_desc"
                                    android:textSize="11sp"
                                    android:textColor="#90CAF9"
                                    android:textAlignment="center" />

                            </LinearLayout>

                        </LinearLayout>

                        <!-- Divider -->
                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:layout_marginHorizontal="28dp"
                            android:background="#33FFFFFF" />

                        <!-- Right Column: Code & Actions -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:orientation="vertical">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/psn_login_instructions"
                                android:textSize="15sp"
                                android:textColor="?android:textColorPrimary"
                                android:layout_marginBottom="2dp" />

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/psn_login_code_label"
                                android:textSize="12sp"
                                android:textColor="?android:textColorSecondary" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/loginCodeText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="------"
                                android:textSize="38sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"
                                android:fontFamily="monospace"
                                android:letterSpacing="0.25"
                                android:layout_marginBottom="16dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/checkStatusButton"
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:text="@string/psn_login_check_status"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:focusable="true"
                                android:layout_marginBottom="8dp"
                                app:cornerRadius="12dp"
                                app:backgroundTint="@color/psn_blue"
                                android:textColor="#FFFFFF" />

                            <!-- Sign In on This Device (switches to WebView) -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/openBrowserButton"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:text="@string/psn_login_switch_to_direct"
                                android:textSize="14sp"
                                android:focusable="true"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_marginBottom="8dp"
                                app:cornerRadius="12dp"
                                app:strokeColor="@color/accent"
                                android:textColor="#FFFFFF"
                                app:iconGravity="textStart"
                                app:iconTint="@color/accent"
                                app:icon="@android:drawable/ic_menu_view" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/manualTokenButton"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:text="@string/psn_login_paste_npsso"
                                android:textSize="13sp"
                                android:focusable="true"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:textColor="#90CAF9"
                                android:layout_marginBottom="8dp"
                                app:cornerRadius="12dp" />

                            <!-- Status line -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginBottom="12dp">

                                <ProgressBar
                                    android:id="@+id/progressBar"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_marginEnd="8dp"
                                    android:visibility="visible" />

                                <com.google.android.material.textview.MaterialTextView
                                    android:id="@+id/statusText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/psn_login_connecting"
                                    android:textSize="13sp"
                                    android:textColor="?android:textColorSecondary" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="end">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/configureRelayButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/psn_login_configure_relay"
                                    android:textSize="11sp"
                                    android:focusable="true"
                                    style="@style/Widget.MaterialComponents.Button.TextButton"
                                    android:textColor="?android:textColorTertiary" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/cancelButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/action_cancel"
                                    android:textSize="12sp"
                                    android:focusable="true"
                                    style="@style/Widget.MaterialComponents.Button.TextButton"
                                    android:textColor="?android:textColorTertiary" />
                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </ScrollView>

            </FrameLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
