# frozen_string_literal: true

require "fileutils"

default_platform(:android)

platform :android do
  desc "Upload Android release (AAB and/or APK) to Google Play Console"
  lane :upload_to_play do |options|
    aab_path = options[:aab] || ENV["ASTRAPLAY_AAB_PATH"]
    apk_path = options[:apk] || ENV["ASTRAPLAY_APK_PATH"]

    json_key = ENV["GOOGLE_PLAY_JSON_KEY_PATH"]
    UI.user_error!("Set GOOGLE_PLAY_JSON_KEY_PATH to the service account JSON") if json_key.nil? || json_key.empty?
    UI.user_error!("JSON key not found: #{json_key}") unless File.file?(json_key)

    track = options[:track] || ENV.fetch("ASTRAPLAY_PLAY_TRACK", "beta")
    UI.message("Uploading to Google Play track: #{track}")

    vc = ENV["ANDROID_VERSION_CODE"]
    if vc.nil? || vc.empty?
      android_root = File.expand_path("..", __dir__)
      out = sh("cd #{android_root} && ./gradlew :app:printAstraPlayVersionCode --console=plain 2>&1 | grep '^ASTRAPLAY_VERSION_CODE=' | tail -1 | cut -d= -f2", log: false).strip
      vc = out unless out.empty?
    end
    UI.user_error!("Could not determine Android versionCode (set ANDROID_VERSION_CODE or run from android/ with Gradle)") if vc.nil? || vc.empty?

    changelog_dir = File.expand_path("metadata/android/en-US/changelogs", __dir__)
    FileUtils.mkdir_p(changelog_dir)
    vc_changelog = File.join(changelog_dir, "#{vc}.txt")
    default_changelog = File.join(changelog_dir, "default.txt")
    unless File.file?(vc_changelog)
      if File.file?(default_changelog)
        FileUtils.cp(default_changelog, vc_changelog)
        UI.message("Copied default changelog to #{vc}.txt")
      else
        File.write(vc_changelog, "Continuing to provide regular updates and improvements for a better experience!\n")
        UI.message("Wrote fallback changelog to #{vc}.txt")
      end
    end

    supply_args = {
      json_key: json_key,
      package_name: "io.github.nileshchakraborty.astraplay",
      track: track,
      skip_upload_metadata: true,
      skip_upload_changelogs: false,
      skip_upload_images: true,
      skip_upload_screenshots: true
    }

    # If AAB is available, prefer AAB for store tracks
    if aab_path && File.file?(aab_path)
      UI.message("Deploying App Bundle (AAB): #{aab_path}")
      supply_args[:aab] = aab_path
    elsif apk_path && File.file?(apk_path)
      UI.message("Deploying APK binary: #{apk_path}")
      supply_args[:apk] = apk_path
    else
      UI.user_error!("Neither AAB nor APK found for Google Play deployment")
    end

    upload_to_play_store(supply_args)

    # If APK is also present and internal app sharing is enabled, deploy APK to Internal App Sharing
    if apk_path && File.file?(apk_path) && (ENV["UPLOAD_APK_TO_PLAY"] == "true" || ENV["UPLOAD_APK_INTERNAL_SHARING"] == "true")
      UI.message("Deploying APK to Google Play Internal App Sharing: #{apk_path}")
      upload_to_play_store_internal_app_sharing(
        json_key: json_key,
        package_name: "io.github.nileshchakraborty.astraplay",
        apk: apk_path
      )
    end
  end

  desc "Upload AAB to Google Play"
  lane :upload_astraplay_aab do
    upload_to_play
  end

  desc "Upload APK to Google Play"
  lane :upload_astraplay_apk do
    apk_path = ENV["ASTRAPLAY_APK_PATH"]
    upload_to_play(apk: apk_path)
  end

  desc "Upload APK to Google Play Internal App Sharing"
  lane :upload_internal_app_sharing do
    apk_path = ENV["ASTRAPLAY_APK_PATH"]
    json_key = ENV["GOOGLE_PLAY_JSON_KEY_PATH"]
    UI.user_error!("Set GOOGLE_PLAY_JSON_KEY_PATH to the service account JSON") if json_key.nil? || json_key.empty?
    UI.user_error!("APK not found: #{apk_path}") if apk_path.nil? || !File.file?(apk_path)

    upload_to_play_store_internal_app_sharing(
      json_key: json_key,
      package_name: "io.github.nileshchakraborty.astraplay",
      apk: apk_path
    )
  end
end
